    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "User demo, sau đó đăng nhập admin để ghi adminToken",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"minhanh@tech.local\",\n  \"password\": \"TechUser@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  " const obj=pm.response.json();",
                  " pm.collectionVariables.set(obj.user.role === \"admin\" ? \"adminToken\" : \"userToken\", obj.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "description": "Tạo user mới",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguyễn Văn Demo\",\n  \"email\": \"demo-new@tech.local\",\n  \"password\": \"TechUser@2026\",\n  \"phone\": \"0901234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "description": "Profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ]
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Quên mật khẩu",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"minhanh@tech.local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT /auth/password",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/auth/password",
            "description": "Đổi mật khẩu",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"TechUser@2026\",\n  \"newPassword\": \"TechUser@2027\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
